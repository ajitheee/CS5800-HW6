@startuml

title HW4 Part 5 - Composition Class Diagram

class File {
    - name : String
    + File(name : String)
    + getName() : String
    + setName(name : String) : void
    + print(indent : String) : void
}

class Folder {
    - name : String
    - files : ArrayList<File>
    - subFolders : ArrayList<Folder>
    + Folder(name : String)
    + getName() : String
    + setName(name : String) : void
    + getFiles() : ArrayList<File>
    + getSubFolders() : ArrayList<Folder>
    + addFile(file : File) : void
    + addSubFolder(folder : Folder) : void
    + deleteSubFolder(folderName : String) : void
    + print() : void
}

Folder "1" *-- "0..*" File : contains
Folder "1" *-- "0..*" Folder : contains

@enduml